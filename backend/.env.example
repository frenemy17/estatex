# ===========================================================================
# EstateX backend configuration
#
# Copy to `backend/.env`. With NOTHING set except MONGO_URL the app runs a
# complete, deterministic, offline demo: every provider is mocked and every
# lead still flows capture -> call -> qualify -> score -> route -> book.
#
# Each block below is independent. Fill one in and that single integration
# goes LIVE — no code change, and the dashboard chip turns green. Check
# `GET /api/providers` to see exactly which are live and which are mocked.
# ===========================================================================

# ---------- Required ----------

# MongoDB connection string. Local Docker or a free Atlas M0 cluster.
# (Atlas: mongodb+srv://user:pass@cluster.xxxx.mongodb.net/?retryWrites=true&w=majority)
MONGO_URL=mongodb://localhost:27017
DB_NAME=estatex_db

# ---------- Strongly recommended ----------

# Guards the destructive/expensive routes: POST /api/seed, /api/simulate,
# /api/leads/bulk, /api/tick and DELETE /api/reset. Those routes return 401
# when this is unset, so a public deploy is read-only by default.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Comma-separated allowed origins. Defaults to * — set it in production.
CORS_ORIGINS=*

# ---------- Demo behaviour ----------

# DEMO_MODE=1 forces every provider to MOCK even when keys are present, and
# keeps the 1.2s "call in progress" beat so the Kanban animates. This is the
# setting for a public portfolio deploy: deterministic, free, no third party
# ever contacted.
DEMO_MODE=1

# Seconds to hold a lead in CALLING during the mock call. Only applied in
# DEMO_MODE; live calls are paced by the provider.
DEMO_CALL_DELAY_SECONDS=1.2

# ---------- LLM: Groq (free tier, no card) ----------
# Unlocks: real qualification + supervisor reasoning. Without it the pipeline
# falls back to deterministic keyword extraction, and /api/eval reports
# baseline_only: true.
# Get one: https://console.groq.com/keys
GROQ_API_KEY=

# ---------- Email: Resend (free tier: 100/day) ----------
# Unlocks: real nurture + booking-confirmation email.
# Seeded demo leads use @example.com addresses that can never deliver, so set
# DEMO_EMAIL to route every outbound message to your own inbox.
# Until you verify a domain, FROM_EMAIL must stay on onboarding@resend.dev.
# Get one: https://resend.com/api-keys
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
DEMO_EMAIL=

# ---------- Booking: Cal.com (free tier) ----------
# Unlocks: real viewing slots on GET /api/leads/:id/slots and real bookings.
# A failed booking is reported as a 502 and the lead is NOT marked BOOKED.
# Get them: https://app.cal.com/settings/developer/api-keys
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# ---------- CRM: HubSpot (free tier) ----------
# Unlocks: contact upsert (idempotent on email) + deal creation, associated.
# Create a private app with crm.objects.contacts.write + crm.objects.deals.write.
# Get one: https://developers.hubspot.com/docs/api/private-apps
HUBSPOT_ACCESS_TOKEN=

# ---------- SMS: Twilio (wired, off by default) ----------
# US SMS needs A2P 10DLC registration (days) and a trial account can only text
# verified numbers, so keys alone are not enough — SMS_ENABLED=1 is the switch.
# Inbound STOP/UNSUBSCRIBE arrives at POST /api/webhooks/twilio-sms and sets
# opted_out, which blocks all further outbound messages.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_ENABLED=

# ---------- Voice: Vapi (wired, off by default) ----------
# Needs a funded account and a purchased number, hence the VOICE_ENABLED gate.
# When live, start_call returns a call id and NO transcript: the lead parks at
# CALLING with awaiting_transcript=true until Vapi POSTs its end-of-call-report
# to  POST /api/webhooks/vapi  (configure that URL as the assistant's server
# URL, with VAPI_WEBHOOK_SECRET as the x-vapi-secret header). Qualification
# never runs on an empty transcript.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
VOICE_ENABLED=

# ---------- Google Ads lead-form webhook ----------
# POST /api/webhooks/google-leads returns 503 while this is unset and 401 on a
# key mismatch — there is deliberately no default value.
GOOGLE_LEADS_WEBHOOK_KEY=

# ---------- Autonomy + compliance tuning ----------

# Outbound messages are held during quiet hours and re-queued in
# scheduled_actions, then sent by the next POST /api/tick. Hours are UTC.
QUIET_HOURS_ENABLED=1
QUIET_HOURS_START=21
QUIET_HOURS_END=8

# A lead sitting in CALLING/IN_CONVERSATION longer than this with no transcript
# is rescued to NURTURE with a call.timeout event on the next tick.
CALL_TIMEOUT_MINUTES=20

# How far out the supervisor's "wait" action schedules its next check.
SUPERVISOR_WAIT_HOURS=6

# Per-IP sliding-window limit on the public POST /api/lead capture form.
LEAD_RATE_LIMIT_PER_MIN=10
